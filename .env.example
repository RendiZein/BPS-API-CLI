# BPS Web API Key (Dapatkan di https://webapi.bps.go.id/developer)
BPS_API_KEY=your_bps_api_key_here

# API Version (v1 atau v2, default v1 untuk akun pengembang publik)
BPS_API_VERSION=v1

# Base URL (default https://webapi.bps.go.id)
BPS_API_BASE_URL=https://webapi.bps.go.id

# Default Domain (0000 untuk Nasional / BPS Pusat)
BPS_DEFAULT_DOMAIN=0000

# Default Language (ind untuk Indonesia, eng untuk English)
BPS_DEFAULT_LANG=ind

# Request Timeout dalam detik
BPS_TIMEOUT=20
